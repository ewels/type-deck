{
  "name": "type-deck",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w --watch.onEnd=\"streamdeck restart com.ewels.type-deck\"",
    "format": "prettier --write . && biome format --write .",
    "format:check": "prettier --check . && biome format .",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "check": "biome check ."
  },
  "type": "module",
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@elgato/cli": "^1.9.0",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@tsconfig/node20": "^20.1.10",
    "@types/node": "~24.13.0",
    "prettier": "3.9.6",
    "rollup": "^4.63.1",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@elgato/streamdeck": "^2.1.2",
    "@nut-tree-fork/libnut": "~4.2.6"
  }
}
